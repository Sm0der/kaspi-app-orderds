# URL бэкенда (Express-сервер из папки server/)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase (Project Settings -> API) - анонимный ключ безопасно светить в браузере,
# доступ к данным всё равно проверяется на бэкенде (см. server/middleware/requireAuth.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
