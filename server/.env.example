# === KASPI API ===
KASPI_API_TOKEN_1=your_first_store_token_here
KASPI_API_TOKEN_2=your_second_store_token_here

# === DATABASE ===
DATABASE_URL=postgresql://kaspi_user:password@localhost:5432/kaspi_orders

# === SERVER ===
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# === PUSH NOTIFICATIONS ===
# Генерировать с помощью: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here

# === AUTH ===
# Вход в системе один: токен выдаёт приложение склада (production/warehouse-production-app),
# этот сервер только проверяет подпись. Значение обязано совпадать с JWT_SECRET склада,
# иначе вошедший будет получать 401 на каждом запросе к заказам.
JWT_SECRET=тот_же_секрет_что_у_склада

# === SYNC ===
SYNC_INTERVAL_MINUTES=15

# === TELEGRAM BOT (future) ===
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
