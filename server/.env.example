# === KASPI API ===
KASPI_API_TOKEN_1=your_first_store_token_here
KASPI_API_TOKEN_2=your_second_store_token_here

# === DATABASE ===
DATABASE_URL=postgresql://kaspi_user:password@localhost:5432/kaspi_orders

# === SERVER ===
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# === PUSH NOTIFICATIONS ===
# Генерировать с помощью: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here

# === AUTH (Supabase) ===
# Project Settings -> API. Достаточно anon-ключа: бэкенд только проверяет чужие токены
# через supabase.auth.getUser(), не создаёт и не удаляет пользователей.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# === SYNC ===
SYNC_INTERVAL_MINUTES=15

# === TELEGRAM BOT (future) ===
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
